# Frontend environment (copy to frontend/.env; never commit .env).
#
# Origin that the Vite dev and preview servers proxy /v1 and /healthz to: the origin of a running RagAssist API.
# The browser only ever talks to the Vite origin, so the refresh cookie stays same-origin and SameSite=Strict.
# The API must also trust the Vite origin for its CSRF check (WEB_BASE_URL or CORS_ORIGINS in the backend .env).
# Required for `npm run dev`; not needed for build, unit tests or the mocked Playwright specs.
API_PROXY_TARGET=

# Optional: fix the port the Playwright web server uses. Empty means a free port is chosen at run time.
PLAYWRIGHT_WEB_PORT=
