# Shared by every proxied location. Rendered by envsubst at container start; only ${WEB_API_UPSTREAM} is substituted.
proxy_pass http://${WEB_API_UPSTREAM};
proxy_http_version 1.1;
# Keep-alive to the upstream: clear the Connection header instead of forwarding the client's.
proxy_set_header Connection "";
proxy_set_header Host $http_host;
# This proxy is the edge: it overwrites X-Forwarded-For with the address it saw, so a client cannot choose the
# address the sign-in throttle counts. Put a trusted load balancer in front only with set_real_ip_from (ADR 0014).
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $http_host;
proxy_redirect off;
