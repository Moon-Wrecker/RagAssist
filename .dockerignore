# ============================================================================
# RagAssist — Docker Ignore Rules
# Keep synchronized with .gitignore and AGENTS.md
# ============================================================================

.git
.github
.gitignore
.gitattributes
.editorconfig
.pre-commit-config.yaml

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example

# --- Agent Workspaces, Sessions & Swarm Artifacts ---
.agents/
.gemini/
.claude/

__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
build/
dist/
*.egg-info/

.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage*
htmlcov/
.import_linter_cache/

.cache/
models_cache/
hf_cache/
flashrank_cache/
.localstack/
volume/
postgres_data/
paradedb_data/
ollama_data/

**/.terraform/*
*.tfstate*

tests/
evals/reports/runs/
docs/
node_modules/
# The API image never needs the web app. The web image (Slice 6) builds from frontend/ with its own context,
# so these entries also keep a local node_modules and test output out of any root-context build.
frontend/
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
.vscode/
.idea/
*.md
!README.md

# Generated test reports
/reports/
coverage.json
