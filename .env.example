# ==============================================================================
# RagAssist Environment Configuration Template
# Synchronized with src/ragassist/shared/config/settings.py and AGENTS.md
#
# Nothing is configured in code: every value below is read from the environment.
# Create your working file with:   ragassist init-env     (writes .env, generating the blank secrets)
# or copy this file to .env and fill every blank marked REQUIRED yourself. Never commit .env.
# ==============================================================================

# --- Application & Environment ---
APP_NAME=RagAssist
APP_ENV=development                       # development, test, staging, production
DEBUG=true
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR
API_V1_PREFIX=/v1
# REQUIRED. JWT signing key, at least 32 random characters in staging/production. Generated by init-env.
SECRET_KEY=
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# --- Database & Row-Level Security (PostgreSQL 16 + pgvector) ---
# The connection URLs are built from these parts, so each password is configured in exactly one place.
# Docker Compose reads the same variables for the database container (it overrides DB_HOST for the services).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragassist
# Restricted application role: not a superuser and without BYPASSRLS, so row-level security binds it.
DB_APP_USER=app_user
# REQUIRED. Password of the application role. Generated by init-env.
DB_APP_PASSWORD=
# Owner/superuser role used only by Alembic migrations, the seed command and the database container.
DB_ADMIN_USER=postgres
# REQUIRED. Password of the owner role. Generated by init-env.
DB_ADMIN_PASSWORD=
# Optional full-URL overrides for a managed database; leave empty to use the parts above.
DATABASE_URL=
DATABASE_ADMIN_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
# "postgres" = the real runtime (Postgres persistence, LangGraph checkpointer, assistant graph).
# "memory"   = in-process stores and a canned assistant reply (used by the automated tests).
PERSISTENCE_BACKEND=postgres

# --- Security & JWT (Dev Stub / Tenant Claims) ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 hours
# REQUIRED. Secret of the development token endpoint; callers send it in the X-Dev-Auth-Secret header. Generated by init-env.
DEV_AUTH_SECRET=

# --- Sign-in (workspace + email + password; argon2id hashes; rotating httpOnly refresh cookie) ---
# Access token lifetime handed out by login and refresh (the refresh cookie renews it silently).
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=14
# How long an invite or password-reset link stays valid.
AUTH_INVITE_HOURS=72
AUTH_MIN_PASSPHRASE_LENGTH=12
# true = the refresh cookie is only sent over HTTPS. Must be true in staging and production.
AUTH_COOKIE_SECURE=false
# Throttle: failed attempts per account, and attempts per client address, inside the window.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_MAX_PER_IP=30
AUTH_LOGIN_WINDOW_SECONDS=900
# Public origin of the web app. Invite and password-reset links are built from it.
WEB_BASE_URL=http://localhost:5173

# --- AWS & LocalStack Infrastructure ---
AWS_REGION=us-east-1
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
# REQUIRED. LocalStack accepts any non-empty pair; use real IAM credentials against AWS. Generated by init-env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCS=ragassist-docs
SQS_QUEUE_INGEST=ragassist-ingest
SQS_QUEUE_INGEST_DLQ=ragassist-ingest-dlq
SECRETS_MANAGER_SECRET_NAME=ragassist/config

# --- Mock SaaS Client & Integration ---
MOCK_SAAS_BASE_URL=http://localhost:8001
MOCK_SAAS_TIMEOUT_SECONDS=10.0

# --- Model Providers (Any Model via Provider Registry) ---
MODELS_CONFIG_PATH=config/models.yaml
# API Keys for Primary and Swappable Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Google Gemini (optional). Leave GEMINI_API_KEY empty to disable: Gemini fallbacks are then skipped.
# Get a key at https://aistudio.google.com/apikey . Models: gemini-flash-latest, gemini-flash-lite-latest, gemini-pro-latest.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Custom OpenAI-compatible endpoints (Ollama, vLLM, LM Studio, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# Optional. Ollama ignores the key; vLLM/Gemini/other gateways need theirs.
OPENAI_COMPATIBLE_API_KEY=
# Optional. When set, ALL LLM roles use this one model on the endpoint above (e.g. llama3.1:8b, or a Gemini model
# when OPENAI_COMPATIBLE_BASE_URL is https://generativelanguage.googleapis.com/v1beta/openai/).
OPENAI_COMPATIBLE_MODEL=
# Embedding model served by the OpenAI-compatible endpoint (used when EMBEDDING_FALLBACK_CHAIN includes it).
OPENAI_COMPATIBLE_EMBEDDING_MODEL=nomic-embed-text

# Role-specific model selectors (optional overrides; leave empty to use config/models.yaml roles)
LLM_ROLE_GENERATOR_PRIMARY=
LLM_ROLE_GENERATOR_FALLBACKS=
LLM_ROLE_REWRITER_PRIMARY=
LLM_ROLE_AGENT_PRIMARY=
LLM_ROLE_JUDGE_PRIMARY=
LLM_ROLE_DECIDER_FALLBACK=

# --- Embeddings & Vector Search ---
EMBEDDING_PROVIDER=openai                 # openai, openai_compatible, sentence_transformers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=15.0
EMBEDDING_FALLBACK_CHAIN=openai,sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_DEVICE=auto
VECTOR_SEARCH_TOP_K=30
VECTOR_SEARCH_ITERATIVE_SCAN=relaxed_order  # off, relaxed_order, strict_order

# --- Keyword Search ---
KEYWORD_SEARCH_BACKEND=fts                # fts (native Postgres), paradedb (ParadeDB BM25)
KEYWORD_SEARCH_TOP_K=30

# --- Hybrid Retrieval & Reranker Chain ---
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_N=6
RERANK_ENABLED=true
# Priority chain on machine with RTX 3060: cross_encoder,flashrank,none
RERANKER_CHAIN=cross_encoder,flashrank,none
RERANK_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
RERANK_TIMEOUT_MS=1500

# --- Hybrid Chunking (5-pass structure-aware) ---
CHUNK_STRATEGY=hybrid                     # hybrid, docling_hybrid, recursive, semantic
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MERGE_PEERS=true
CHUNK_SEMANTIC=false
CHUNK_PARENT_CHILD=false

# --- Decision Layer (Jev / OpenAI Decisions / Strands / Fallbacks) ---
DECIDER_CHAIN=openai_decisions,jev,llm_structured,rules
ROUTER_DECIDER_CHAIN=semantic_router,openai_decisions,llm_structured,rules
DECIDER_MIN_CONFIDENCE=0.70
# Per decider call. LLM-backed deciders (llm_structured, openai_decisions) need several seconds; a value that is
# too small makes every member time out, the safety check fail closed and every question be refused.
DECIDER_TIMEOUT_MS=8000
ESCALATION_THRESHOLD=0.65

# TypeSafe AI Jev credentials
TYPESAFE_API_KEY=
# OpenAI Decisions API credentials (uses standard OPENAI_API_KEY if blank)
OPENAI_DECISIONS_API_KEY=
# Strands Local Decider HTTP endpoint (served via local-ml profile)
STRANDS_DECIDER_ENDPOINT=http://localhost:8002/v1/decide

# --- Observability & Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragassist-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Langfuse tracing (https://langfuse.com). Off by default. When on, each assistant turn is traced with its
# retrieval, model calls, tools and approvals; secrets (tokens, keys, passwords) are redacted before export, but
# the conversation text and retrieved passages are sent to the Langfuse project, so pick the region and project
# deliberately. Keys: Langfuse project -> Settings -> API Keys. Cloud regions: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), https://jp.cloud.langfuse.com (JP), https://hipaa.cloud.langfuse.com (HIPAA),
# or your self-hosted URL.
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Fraction of turns to trace, 0.0 to 1.0.
LANGFUSE_SAMPLE_RATE=1.0
PROMETHEUS_METRICS_ENABLED=true

# --- Ingestion Worker ---
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3
WORKER_VISIBILITY_TIMEOUT_SECONDS=120
WORKER_POLL_WAIT_SECONDS=10

# --- Live events stream (GET /v1/events, ADR 0008) ---
# Concurrent event streams one user may hold per API process (browser tabs); more are answered with 429.
EVENTS_MAX_STREAMS_PER_USER=5
# Events queued per connected stream; a slow client that overflows it receives `resync` and refetches.
EVENTS_QUEUE_SIZE=100
