# ==============================================================================
# RagAssist Environment Configuration Template
# Synchronized with src/ragassist/shared/config/settings.py and AGENTS.md
# ==============================================================================

# --- Application & Environment ---
APP_NAME=RagAssist
APP_ENV=development                       # development, test, staging, production
DEBUG=true
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR
API_V1_PREFIX=/v1
SECRET_KEY=<redacted>
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# --- Database & Row-Level Security (PostgreSQL 16 + pgvector) ---
# Non-superuser connection string for RLS enforcement (app_user)
DATABASE_URL=postgresql+asyncpg://app_user:<redacted>@localhost:5432/ragassist
# Superuser connection string used exclusively by Alembic migrations
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:<redacted>@localhost:5432/ragassist
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0

# --- Security & JWT (Dev Stub / Tenant Claims) ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 hours
DEV_AUTH_SECRET=<redacted>

# --- AWS & LocalStack Infrastructure ---
AWS_REGION=us-east-1
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_DOCS=ragassist-docs
SQS_QUEUE_INGEST=ragassist-ingest
SQS_QUEUE_INGEST_DLQ=ragassist-ingest-dlq
SECRETS_MANAGER_SECRET_NAME=ragassist/config

# --- Mock SaaS Client & Integration ---
MOCK_SAAS_BASE_URL=http://localhost:8001
MOCK_SAAS_TIMEOUT_SECONDS=10.0

# --- Model Providers (Any Model via Provider Registry) ---
MODELS_CONFIG_PATH=config/models.yaml
# API Keys for Primary and Swappable Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Custom OpenAI-compatible endpoints (Ollama, vLLM, LM Studio, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama

# Role-specific model selectors (optional overrides; leave empty to use config/models.yaml roles)
LLM_ROLE_GENERATOR_PRIMARY=
LLM_ROLE_GENERATOR_FALLBACKS=
LLM_ROLE_REWRITER_PRIMARY=
LLM_ROLE_AGENT_PRIMARY=
LLM_ROLE_JUDGE_PRIMARY=
LLM_ROLE_DECIDER_FALLBACK=

# --- Embeddings & Vector Search ---
EMBEDDING_PROVIDER=openai                 # openai, openai_compatible, sentence_transformers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=15.0
EMBEDDING_FALLBACK_CHAIN=openai,sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_DEVICE=auto
VECTOR_SEARCH_TOP_K=30
VECTOR_SEARCH_ITERATIVE_SCAN=relaxed_order  # relaxed_order, strict_order

# --- Keyword Search ---
KEYWORD_SEARCH_BACKEND=fts                # fts (native Postgres), paradedb (ParadeDB BM25)
KEYWORD_SEARCH_TOP_K=30

# --- Hybrid Retrieval & Reranker Chain ---
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_N=6
RERANK_ENABLED=true
# Priority chain on machine with RTX 3060: cross_encoder,flashrank,none
RERANKER_CHAIN=cross_encoder,flashrank,none
RERANK_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
RERANK_TIMEOUT_MS=1500

# --- Hybrid Chunking (5-pass structure-aware) ---
CHUNK_STRATEGY=hybrid                     # hybrid, docling_hybrid, recursive, semantic
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MERGE_PEERS=true
CHUNK_SEMANTIC=false
CHUNK_PARENT_CHILD=false

# --- Decision Layer (Jev / OpenAI Decisions / Strands / Fallbacks) ---
DECIDER_CHAIN=openai_decisions,jev,llm_structured,rules
ROUTER_DECIDER_CHAIN=semantic_router,openai_decisions,llm_structured,rules
DECIDER_MIN_CONFIDENCE=0.70
DECIDER_TIMEOUT_MS=1000
ESCALATION_THRESHOLD=0.65

# TypeSafe AI Jev credentials
TYPESAFE_API_KEY=
# OpenAI Decisions API credentials (uses standard OPENAI_API_KEY if blank)
OPENAI_DECISIONS_API_KEY=
# Strands Local Decider HTTP endpoint (served via local-ml profile)
STRANDS_DECIDER_ENDPOINT=http://localhost:8002/v1/decide

# --- Observability & Tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragassist-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
PROMETHEUS_METRICS_ENABLED=true

# --- Ingestion Worker ---
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3
WORKER_VISIBILITY_TIMEOUT_SECONDS=120
WORKER_POLL_WAIT_SECONDS=10

