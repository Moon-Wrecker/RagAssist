# Normalize line endings to LF across platforms (critical for Docker/Linux containers on Windows)
* text=auto eol=lf

# Explicitly enforce LF on scripts, Dockerfiles, SQL, YAML, and Python
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
package-lock.json text eol=lf -diff
frontend/src/api/schema.d.ts text eol=lf linguist-generated
Dockerfile* text eol=lf
*.Dockerfile text eol=lf
*.Dockerfile.dockerignore text eol=lf
# nginx templates and the entrypoint include are rendered or sourced inside a Linux container
infra/nginx/** text eol=lf
*.template text eol=lf
*.inc text eol=lf
*.envsh text eol=lf

# PowerShell scripts may use CRLF on Windows
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.webp binary
*.onnx binary
*.bin binary
*.safetensors binary

# Git hooks run under sh, so CRLF would break the shebang
.githooks/* text eol=lf
